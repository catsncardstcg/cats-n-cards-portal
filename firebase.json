{
  "functions": [
    {
      "codebase": "default",
      "source": "functions"
    },
    {
      "source": "cats-cards-portal",
      "codebase": "cats-cards-portal",
      "runtime": "nodejs22",
      "region": "asia-southeast1",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "package-lock.json"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
